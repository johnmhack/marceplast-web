---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto"
  description="Contáctanos en Marceplast SAS. Asesoría en moldes e inyección de plásticos."
>

  <!-- HERO -->
  <section class="relative overflow-hidden text-white py-24 sm:py-28 md:py-32 px-5 text-center">
    <img
      src="/img/planta/planta-4.jpeg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover scale-105 blur-[2px] -z-20"
    />
    <div class="absolute inset-0 bg-primario-oscuro/70 -z-10" data-anim="hero-bg"></div>
    <div class="relative max-w-3xl mx-auto">
      <p data-anim="hero-text" class="text-primario-claro font-semibold tracking-widest uppercase text-sm sm:text-base mb-4">
        Estamos listos para ayudarte
      </p>
      <h1 data-anim="hero-title" class="text-4xl sm:text-5xl md:text-6xl font-bold mb-5 leading-tight">
        Contáctanos
      </h1>
      <p data-anim="hero-text" class="text-lg sm:text-xl opacity-95 max-w-2xl mx-auto">
        ¿Tienes alguna pregunta o necesitas más información? Contáctanos y con gusto te brindaremos la asesoría que necesitas.
      </p>
    </div>
  </section>

  <!-- FORMULARIO + INFO -->
  <section data-anim="section-pin" class="bg-white py-14 md:py-20">
    <div class="px-4 sm:px-5 lg:px-6 xl:px-8">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 xl:gap-20 items-start">
        <!-- Info -->
        <div data-anim="reveal">
          <p class="text-primario font-semibold tracking-widest uppercase text-sm sm:text-base mb-3">
            Hablemos
          </p>
          <h2 class="text-4xl sm:text-5xl font-bold text-primario-oscuro mb-6 leading-tight">
            Envíanos un mensaje
          </h2>
          <p class="text-slate-600 text-lg sm:text-xl leading-relaxed mb-8 max-w-xl">
            Completa el formulario o escríbenos directamente. Te responderemos a la brevedad.
          </p>

          <div class="space-y-6">
            <div class="border-l-4 border-primario pl-5">
              <p class="text-sm uppercase tracking-wide text-slate-500 mb-1">Email</p>
              <a
                href="mailto:marceplas_01@hotmail.com"
                class="text-primario-oscuro text-lg sm:text-xl font-semibold break-all hover:text-primario transition-colors"
              >
                marceplas_01@hotmail.com
              </a>
            </div>
            <div class="border-l-4 border-primario pl-5">
              <p class="text-sm uppercase tracking-wide text-slate-500 mb-1">Web</p>
              <a
                href="https://www.marceplastsas.com"
                class="text-primario-oscuro text-lg sm:text-xl font-semibold hover:text-primario transition-colors"
              >
                www.marceplastsas.com
              </a>
            </div>
            <div class="border-l-4 border-primario pl-5">
              <p class="text-sm uppercase tracking-wide text-slate-500 mb-1">Servicios</p>
              <p class="text-primario-oscuro text-lg sm:text-xl font-semibold">
                Moldes e inyección a medida
              </p>
            </div>
          </div>

          <div class="mt-10 flex flex-col sm:flex-row gap-3">
            <a
              href="/inyeccion-productos-plastico"
              class="inline-flex items-center justify-center gap-2 border-2 border-primario text-primario hover:bg-primario hover:text-white transition-colors px-5 py-3 rounded-lg font-semibold"
            >
              Inyección
            </a>
            <a
              href="/diseno-moldes-inyeccion"
              class="inline-flex items-center justify-center gap-2 border-2 border-primario text-primario hover:bg-primario hover:text-white transition-colors px-5 py-3 rounded-lg font-semibold"
            >
              Moldes
            </a>
          </div>
        </div>

        <!-- Form -->
        <div class="rounded-2xl bg-fondo-alterno p-6 sm:p-8 lg:p-10 ring-1 ring-slate-200/80" data-anim="reveal">
          <form
            class="flex flex-col gap-5"
            name="contacto"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
          >
            <input type="hidden" name="form-name" value="contacto" />
            <p class="hidden">
              <label>No llenar: <input name="bot-field" /></label>
            </p>

            <div>
              <label for="nombre" class="block text-sm font-medium text-slate-700 mb-1.5">Nombre completo</label>
              <input
                id="nombre"
                type="text"
                name="nombre"
                placeholder="Tu nombre"
                required
                class="w-full px-4 py-3.5 bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-primario focus:ring-2 focus:ring-primario/20"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-slate-700 mb-1.5">Correo electrónico</label>
              <input
                id="email"
                type="email"
                name="email"
                placeholder="tu@correo.com"
                required
                class="w-full px-4 py-3.5 bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-primario focus:ring-2 focus:ring-primario/20"
              />
            </div>
            <div>
              <label for="telefono" class="block text-sm font-medium text-slate-700 mb-1.5">Teléfono <span class="text-slate-400">(opcional)</span></label>
              <input
                id="telefono"
                type="tel"
                name="telefono"
                placeholder="Tu teléfono"
                class="w-full px-4 py-3.5 bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-primario focus:ring-2 focus:ring-primario/20"
              />
            </div>
            <div>
              <label for="mensaje" class="block text-sm font-medium text-slate-700 mb-1.5">Mensaje</label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="5"
                placeholder="Cuéntanos sobre tu proyecto..."
                required
                class="w-full px-4 py-3.5 bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-primario focus:ring-2 focus:ring-primario/20 resize-y"
              ></textarea>
            </div>

            <button
              type="submit"
              class="bg-primario hover:bg-primario-oscuro transition-colors text-white px-8 py-4 rounded-lg font-semibold text-lg"
            >
              Enviar mensaje
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { initAnimations } from '../scripts/animations.js';
    initAnimations();
  </script>
</Layout>
