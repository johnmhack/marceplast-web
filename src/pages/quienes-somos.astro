---
import Layout from '../layouts/Layout.astro';

const instalaciones = [
  { src: '/img/planta/planta-1.jpeg', alt: 'Máquina de inyección' },
  { src: '/img/planta/planta-3.jpeg', alt: 'Maquinaria de inyección' },
  { src: '/img/planta/planta-4.jpeg', alt: 'Planta de producción' },
];
---

<Layout title="Quiénes Somos">

  <section class="relative overflow-hidden bg-hero-gradient text-white py-20 sm:py-24 md:py-28 px-5 text-center">
    <div data-anim="hero-bg" class="absolute inset-0 bg-hero-gradient opacity-90 -z-10"></div>
    <h1 data-anim="hero-title" class="text-3xl sm:text-4xl font-bold mb-4">Quiénes Somos</h1>
    <p data-anim="hero-text" class="text-base sm:text-lg opacity-95 max-w-xl mx-auto">
      Más de 15 años de experiencia en moldes e inyección de plásticos.
    </p>
  </section>

  <section class="py-16 md:py-24 px-5" data-anim="section-pin">
    <div class="max-w-3xl mx-auto text-center" data-anim="reveal">
      <p class="text-slate-500 mb-4">
        Con más de 15 años de experiencia, somos una empresa especializada en el
        diseño y fabricación de moldes para inyección, así como en la producción de
        productos plásticos de alta calidad para los sectores promocional, industrial y del
        hogar. Contamos con tecnología de última generación y un equipo altamente
        calificado que nos permite desarrollar soluciones innovadoras, eficientes y
        confiables, adaptadas a las necesidades de cada cliente.
      </p>
      <p class="text-slate-500">
        Nuestro compromiso con la calidad, la innovación, la precisión y el cumplimiento
        nos ha consolidado como un aliado estratégico, ofreciendo productos y procesos
        que cumplen con los más altos estándares de excelencia.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24 px-5 bg-fondo-alterno" data-anim="section-pin">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-primario text-center mb-8 md:mb-12" data-anim="reveal">
        Misión, Visión y Valores
      </h2>
      <div data-anim="stagger-group" class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
          <h3 class="text-primario font-semibold mb-2">Misión</h3>
          <p class="text-slate-500 text-sm">
            Brindar soluciones integrales en el diseño y fabricación de moldes para inyección,
            así como en la producción de productos plásticos de alta calidad para los sectores
            promocional, industrial y del hogar. Nos enfocamos en satisfacer las necesidades
            de nuestros clientes mediante procesos eficientes, tecnología de última
            generación y un equipo comprometido con la calidad, la innovación y el
            cumplimiento.
          </p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
          <h3 class="text-primario font-semibold mb-2">Visión</h3>
          <p class="text-slate-500 text-sm">
            Ser una empresa líder y referente en la industria de la inyección de plásticos y
            fabricación de moldes, reconocida por la innovación, la excelencia en nuestros
            procesos y la confianza que generamos en nuestros clientes. Para el año 2030,
            buscamos fortalecer nuestra presencia en el mercado nacional e internacional,
            incorporando nuevas tecnologías y consolidándonos como un aliado estratégico
            para el desarrollo de soluciones plásticas de alto valor.
          </p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
          <h3 class="text-primario font-semibold mb-2">Valores</h3>
          <ul class="text-slate-500 text-sm list-disc list-inside space-y-2 text-left">
            <li>Calidad</li>
            <li>Innovación</li>
            <li>Precisión</li>
            <li>Cumplimiento</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 px-5" data-anim="section-pin">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-primario text-center mb-3" data-anim="reveal">
        Nuestras Instalaciones
      </h2>
      <p class="text-slate-500 text-center mb-8 md:mb-12" data-anim="reveal">
        Conoce un poco de nuestra planta y equipo de trabajo. Haz clic en una foto para ampliarla.
      </p>
      <div data-anim="stagger-group" class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-8">
        {instalaciones.map((foto) => (
          <button
            type="button"
            class="lightbox-trigger group relative rounded-xl overflow-hidden h-52 sm:h-56 cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-primario"
            data-src={foto.src}
            data-alt={foto.alt}
            aria-label={`Ampliar: ${foto.alt}`}
          >
            <img
              data-anim="parallax-img"
              src={foto.src}
              alt={foto.alt}
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div
    id="lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Imagen ampliada"
  >
    <button
      type="button"
      id="lightbox-close"
      class="absolute top-4 right-4 text-white text-3xl leading-none p-2 hover:opacity-80"
      aria-label="Cerrar"
    >
      &times;
    </button>
    <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-full object-contain rounded-lg shadow-2xl" />
  </div>

  <script>
    import { initAnimations } from '../scripts/animations.js';
    initAnimations();

    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const closeBtn = document.getElementById('lightbox-close');

    const openLightbox = (src, alt) => {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.setAttribute('src', src);
      lightboxImg.setAttribute('alt', alt);
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      if (!lightbox || !lightboxImg) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      lightboxImg.setAttribute('src', '');
      document.body.style.overflow = '';
    };

    document.querySelectorAll('.lightbox-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        openLightbox(btn.getAttribute('data-src'), btn.getAttribute('data-alt') || '');
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  </script>
</Layout>
