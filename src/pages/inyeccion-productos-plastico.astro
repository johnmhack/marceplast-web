---
import Layout from '../layouts/Layout.astro';

const galeria = [
  { src: '/img/planta/planta-1.jpeg', alt: 'Máquina de inyección' },
  { src: '/img/planta/planta-2.jpeg', alt: 'Panel de control de inyección' },
  { src: '/img/planta/inyeccion-1.jpeg', alt: 'Molde en máquina de inyección' },
  { src: '/img/planta/quienes-home.jpg', alt: 'Línea de producción' },
  { src: '/img/planta/planta-3.jpeg', alt: 'Maquinaria de inyección' },
  { src: '/img/planta/planta-4.jpeg', alt: 'Vista general de la planta' },
];

const sectores = [
  {
    title: 'Promocional',
    description: 'Piezas y productos plásticos para campañas, marcas y merchandising.',
  },
  {
    title: 'Industrial',
    description: 'Componentes confiables para aplicaciones técnicas y de producción.',
  },
  {
    title: 'Hogar',
    description: 'Productos plásticos de uso cotidiano con acabado y calidad consistentes.',
  },
];
---

<Layout
  title="Inyección de Productos Plásticos"
  description="Producción de productos plásticos por inyección para los sectores promocional, industrial y del hogar."
>

  <!-- HERO -->
  <section class="relative overflow-hidden text-white py-24 sm:py-28 md:py-32 px-5 text-center">
    <img
      src="/img/planta/planta-1.jpeg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover scale-105 blur-[2px] -z-20"
    />
    <div class="absolute inset-0 bg-primario-oscuro/70 -z-10" data-anim="hero-bg"></div>
    <div class="relative max-w-3xl mx-auto">
      <p data-anim="hero-text" class="text-primario-claro font-semibold tracking-widest uppercase text-sm sm:text-base mb-4">
        Producción
      </p>
      <h1 data-anim="hero-title" class="text-4xl sm:text-5xl md:text-6xl font-bold mb-5 leading-tight">
        Inyección de Productos Plásticos
      </h1>
      <p data-anim="hero-text" class="text-lg sm:text-xl opacity-95 max-w-2xl mx-auto">
        Fabricamos piezas plásticas de alta calidad con tecnología de última generación
        y procesos eficientes adaptados a cada cliente.
      </p>
    </div>
  </section>

  <!-- INTRO -->
  <section data-anim="section-pin" class="bg-white py-14 md:py-20">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-20 xl:gap-28 items-center px-4 sm:px-5 lg:px-6 xl:px-8">
      <div class="relative overflow-hidden rounded-2xl aspect-[4/3] sm:aspect-[16/11] lg:aspect-auto lg:min-h-[30rem] xl:min-h-[34rem]" data-anim="reveal">
        <img
          src="/img/planta/quienes-home.jpg"
          alt="Producción por inyección en Marceplast"
          class="absolute inset-0 w-full h-full object-cover object-center"
        />
      </div>

      <div class="lg:pl-6 xl:pl-12" data-anim="reveal">
        <p class="text-primario font-semibold tracking-widest uppercase text-sm sm:text-base mb-3">
          Capacidad productiva
        </p>
        <h2 class="text-4xl sm:text-5xl font-bold text-primario-oscuro mb-6 leading-tight">
          Producción a medida
        </h2>
        <p class="text-slate-600 mb-5 text-lg sm:text-xl leading-relaxed">
          Desarrollamos y producimos productos plásticos para los sectores promocional,
          industrial y del hogar.
        </p>
        <p class="text-slate-600 text-lg sm:text-xl leading-relaxed">
          Nuestro equipo y maquinaria nos permiten entregar soluciones confiables,
          con precisión y cumplimiento en cada proyecto.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTORES -->
  <section data-anim="section-pin" class="bg-fondo-alterno py-14 md:py-20">
    <div class="px-4 sm:px-5 lg:px-6 xl:px-8">
      <div class="mb-10 md:mb-14 grid lg:grid-cols-[1.1fr_0.9fr] gap-6 lg:gap-16 items-end" data-anim="reveal">
        <div>
          <p class="text-primario font-semibold tracking-widest uppercase text-sm sm:text-base mb-3">
            Sectores
          </p>
          <h2 class="text-4xl sm:text-5xl xl:text-6xl font-bold text-primario-oscuro leading-tight">
            Para tu industria
          </h2>
        </div>
        <div class="border-t-4 border-primario pt-4 lg:border-t-0 lg:border-l-4 lg:pt-0 lg:pl-6">
          <p class="text-slate-600 text-lg sm:text-xl leading-relaxed">
            Adaptamos procesos y acabados según el uso final de cada producto.
          </p>
        </div>
      </div>

      <div data-anim="stagger-group" class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {sectores.map((s, i) => (
          <article class="rounded-2xl bg-white p-7 sm:p-8 ring-1 ring-slate-200/80">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primario text-white font-bold mb-4">
              {i + 1}
            </span>
            <h3 class="text-primario-oscuro text-2xl font-bold mb-3">{s.title}</h3>
            <p class="text-slate-600 text-base sm:text-lg leading-relaxed">{s.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PLANTA / GALERÍA -->
  <section data-anim="section-pin" class="bg-white py-14 md:py-20">
    <div class="px-4 sm:px-5 lg:px-6 xl:px-8">
      <div class="mb-10 md:mb-12 max-w-3xl" data-anim="reveal">
        <p class="text-primario font-semibold tracking-widest uppercase text-sm sm:text-base mb-3">
          Tecnología
        </p>
        <h2 class="text-4xl sm:text-5xl font-bold text-primario-oscuro mb-4 leading-tight">
          Nuestra planta
        </h2>
        <p class="text-slate-600 text-lg sm:text-xl leading-relaxed">
          Maquinaria de inyección y procesos preparados para producción en serie.
          Haz clic en una foto para ampliarla.
        </p>
      </div>

      <div data-anim="stagger-group" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
        {galeria.map((foto) => (
          <button
            type="button"
            class="lightbox-trigger group relative rounded-2xl overflow-hidden aspect-[4/3] cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-primario focus:ring-offset-2"
            data-src={foto.src}
            data-alt={foto.alt}
            aria-label={`Ampliar: ${foto.alt}`}
          >
            <img
              src={foto.src}
              alt={foto.alt}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <span class="absolute inset-0 bg-primario-oscuro/0 group-hover:bg-primario-oscuro/20 transition-colors" aria-hidden="true"></span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-fondo-alterno py-14 md:py-20 px-4 sm:px-5 lg:px-6 xl:px-8 text-center" data-anim="section-pin">
    <div class="max-w-2xl mx-auto" data-anim="reveal">
      <h2 class="text-3xl sm:text-4xl font-bold text-primario-oscuro mb-4 leading-tight">
        ¿Tienes un producto en mente?
      </h2>
      <p class="text-slate-600 text-lg sm:text-xl mb-8 leading-relaxed">
        Cuéntanos tu necesidad y te acompañamos desde el desarrollo hasta la producción.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contactanos"
          class="inline-flex items-center justify-center gap-2 bg-primario hover:bg-primario-oscuro transition-colors text-white px-8 py-4 rounded-lg font-semibold text-lg"
        >
          Contáctanos
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/diseno-moldes-inyeccion"
          class="inline-flex items-center justify-center gap-2 border-2 border-primario text-primario hover:bg-primario hover:text-white transition-colors px-8 py-4 rounded-lg font-semibold text-lg"
        >
          Ver moldes
        </a>
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div
    id="lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Imagen ampliada"
  >
    <button
      type="button"
      id="lightbox-close"
      class="absolute top-4 right-4 text-white text-3xl leading-none p-2 hover:opacity-80"
      aria-label="Cerrar"
    >
      &times;
    </button>
    <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-full object-contain rounded-lg shadow-2xl" />
  </div>

  <script>
    import { initAnimations } from '../scripts/animations.js';
    initAnimations();

    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const closeBtn = document.getElementById('lightbox-close');

    const openLightbox = (src, alt) => {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.setAttribute('src', src);
      lightboxImg.setAttribute('alt', alt);
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      if (!lightbox || !lightboxImg) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      lightboxImg.setAttribute('src', '');
      document.body.style.overflow = '';
    };

    document.querySelectorAll('.lightbox-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        openLightbox(btn.getAttribute('data-src'), btn.getAttribute('data-alt') || '');
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  </script>
</Layout>
