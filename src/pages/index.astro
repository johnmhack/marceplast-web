---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";

const serviciosDestacados = [
  {
    img: "/img/planta/planta-1.jpeg",
    title: "Inyección de plásticos",
    description: "Producción de piezas plásticas de alta calidad para industria, hogar y promocional.",
    href: "/inyeccion-productos-plastico",
  },
  {
    img: "/img/planta/molde-2.jpeg",
    title: "Diseño de moldes",
    description: "Diseño y fabricación de moldes para inyección con precisión y tecnología avanzada.",
    href: "/diseno-moldes-inyeccion",
  },
  {
    img: "/img/planta/planta-4.jpeg",
    title: "Soluciones a medida",
    description: "Acompañamos cada proyecto con procesos eficientes y un equipo calificado.",
    href: "/quienes-somos",
  },
];
---

<Layout title="Inicio">
  <!-- HERO con video de fondo -->
  <section class="relative overflow-hidden text-white min-h-[calc(100dvh-5rem)] flex items-center justify-center py-20 sm:py-28 md:py-36 px-5 text-center">
    <!-- Fallback imagen (reduced motion / carga) -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat -z-20"
      style="background-image: url('/img/foto-planta.jpeg');"
    >
    </div>
    <video
      class="absolute inset-0 w-full h-full min-h-full min-w-full object-cover -z-20 motion-reduce:hidden"
      autoplay
      muted
      loop
      playsinline
      poster="/img/foto-planta.jpeg"
      aria-hidden="true"
    >
      <source src="/video/hero-bg.mp4" type="video/mp4" />
    </video>
    <!-- Overlay azul oscuro -->
    <div
      data-anim="hero-bg"
      class="absolute inset-0 bg-primario-oscuro opacity-60 -z-10"
    >
    </div>

    <div class="relative z-0 w-full max-w-3xl mx-auto">
      <h1 data-anim="hero-title" class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 sm:mb-5 leading-tight">
        Soluciones en Inyección de Plástico
      </h1>
      <p data-anim="hero-text" class="text-base sm:text-lg max-w-2xl mx-auto mb-6 sm:mb-8 opacity-95 px-1">
        Marceplast transforma ideas en productos plásticos de alta calidad, con
        tecnología de inyección y procesos eficientes para la industria.
      </p>
      <a
        data-anim="hero-btn"
        href="/inyeccion-productos-plastico"
        class="inline-block bg-primario-claro hover:bg-primario-oscuro transition-colors px-6 sm:px-8 py-3.5 sm:py-4 rounded-lg font-semibold"
      >
        Ver Inyección
      </a>
    </div>
  </section>

  <!-- QUIÉNES SOMOS -->
  <section data-anim="section-pin" class="bg-fondo-alterno py-10 md:py-14">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-20 xl:gap-28 items-center px-4 sm:px-5 lg:px-6 xl:px-8">
      <div class="relative overflow-hidden rounded-2xl aspect-[4/3] sm:aspect-[16/11] lg:aspect-auto lg:min-h-[30rem] xl:min-h-[34rem]" data-anim="reveal">
        <img
          src="/img/planta/quienes-home.jpg"
          alt="Planta de producción Marceplast"
          class="absolute inset-0 w-full h-full object-cover object-center"
        />
        <div class="absolute inset-x-0 bottom-0 h-28 sm:h-36 bg-gradient-to-t from-white/90 via-white/40 to-transparent pointer-events-none" aria-hidden="true"></div>
        <p class="absolute bottom-5 left-5 sm:bottom-8 sm:left-8 text-slate-900 text-4xl sm:text-5xl font-bold tracking-tight">
          +15<span class="block text-base sm:text-lg font-medium tracking-normal mt-1">años de experiencia</span>
        </p>
      </div>

      <div class="lg:pl-6 xl:pl-12" data-anim="reveal">
        <p class="text-primario font-semibold tracking-widest uppercase text-sm sm:text-base mb-3">
          Marceplast SAS
        </p>
        <h2 class="text-4xl sm:text-5xl font-bold text-primario-oscuro mb-5 leading-tight">
          ¿Quiénes Somos?
        </h2>
        <p class="text-slate-600 mb-8 text-lg sm:text-xl leading-relaxed max-w-xl">
          Nos especializamos en el diseño y fabricación de moldes para inyección,
          y en productos plásticos de alta calidad para los sectores promocional,
          industrial y del hogar.
        </p>
        <a
          href="/quienes-somos"
          class="inline-flex items-center gap-2 bg-primario hover:bg-primario-oscuro transition-colors text-white px-8 py-4 rounded-lg font-semibold text-lg"
        >
          Conócenos
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- NUESTRO PROCESO -->
  <section data-anim="section-pin" class="bg-white py-14 md:py-20">
    <div class="px-4 sm:px-5 lg:px-6 xl:px-8">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 xl:gap-20 items-center">
        <div data-anim="reveal">
          <p class="text-primario font-semibold tracking-widest uppercase text-sm sm:text-base mb-3">
            Cómo trabajamos
          </p>
          <h2 class="text-4xl sm:text-5xl font-bold text-primario-oscuro mb-5 leading-tight">
            Nuestro Proceso
          </h2>
          <p class="text-slate-600 mb-8 text-lg sm:text-xl leading-relaxed max-w-xl">
            De la idea al producto final: diseñamos, fabricamos moldes e inyectamos
            con precisión para entregar soluciones confiables.
          </p>

          <ol class="space-y-5 mb-8" data-anim="stagger-group">
            <li class="flex gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primario text-white font-bold">1</span>
              <div>
                <p class="font-semibold text-primario-oscuro text-lg">Diseño</p>
                <p class="text-slate-500">Definimos la pieza según tu necesidad y sector.</p>
              </div>
            </li>
            <li class="flex gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primario text-white font-bold">2</span>
              <div>
                <p class="font-semibold text-primario-oscuro text-lg">Molde</p>
                <p class="text-slate-500">Fabricamos el molde con mecanizado de precisión.</p>
              </div>
            </li>
            <li class="flex gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primario text-white font-bold">3</span>
              <div>
                <p class="font-semibold text-primario-oscuro text-lg">Inyección</p>
                <p class="text-slate-500">Producimos en serie con tecnología de última generación.</p>
              </div>
            </li>
          </ol>

          <a
            href="/inyeccion-productos-plastico"
            class="inline-flex items-center gap-2 bg-primario hover:bg-primario-oscuro transition-colors text-white px-8 py-4 rounded-lg font-semibold text-lg"
          >
            Ver inyección
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="relative" data-anim="reveal">
          <div class="overflow-hidden rounded-2xl shadow-lg ring-1 ring-slate-200/80">
            <video
              controls
              playsinline
              poster="/img/planta/quienes-home.jpg"
              class="w-full aspect-video object-cover bg-slate-900"
              preload="metadata"
            >
              <source src="/video/proceso.mp4" type="video/mp4" />
              Tu navegador no soporta el elemento de video.
            </video>
          </div>
          <p class="mt-3 text-sm text-slate-500 text-center lg:text-left">
            Mira un vistazo a nuestra planta en acción.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section data-anim="section-pin" class="bg-fondo-alterno py-14 md:py-20">
    <div class="px-4 sm:px-5 lg:px-6 xl:px-8">
      <div class="mb-10 md:mb-14 grid lg:grid-cols-[1.1fr_0.9fr] gap-6 lg:gap-16 items-end" data-anim="reveal">
        <div>
          <p class="text-primario font-semibold tracking-widest uppercase text-sm sm:text-base mb-3">
            Qué hacemos
          </p>
          <h2 class="text-4xl sm:text-5xl xl:text-6xl font-bold text-primario-oscuro leading-tight">
            Servicios
          </h2>
        </div>
        <div class="border-t-4 border-primario pt-4 lg:border-t-0 lg:border-l-4 lg:pt-0 lg:pl-6">
          <p class="text-slate-600 text-lg sm:text-xl leading-relaxed">
            Soluciones integrales en moldes e inyección de plásticos para impulsar tu proyecto con calidad, precisión y cumplimiento.
          </p>
        </div>
      </div>

      <div
        data-anim="stagger-group"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
      >
        {
          serviciosDestacados.map((p) => (
            <ProductCard
              img={p.img}
              title={p.title}
              description={p.description}
              href={p.href}
            />
          ))
        }
      </div>
    </div>
  </section>

  <script>
    import { initAnimations } from "../scripts/animations.js";
    initAnimations();
  </script>
</Layout>
