---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';

const productos = [
  { img: '/img/producto-1.jpg', title: 'Producto 1', description: 'Descripción del producto: material, uso, sector al que aplica.' },
  { img: '/img/producto-2.jpg', title: 'Producto 2', description: 'Descripción del producto: material, uso, sector al que aplica.' },
  { img: '/img/producto-3.jpg', title: 'Producto 3', description: 'Descripción del producto: material, uso, sector al que aplica.' },
  { img: '/img/producto-4.jpg', title: 'Producto 4', description: 'Descripción del producto: material, uso, sector al que aplica.' },
  { img: '/img/producto-5.jpg', title: 'Producto 5', description: 'Descripción del producto: material, uso, sector al que aplica.' },
  { img: '/img/producto-6.jpg', title: 'Producto 6', description: 'Descripción del producto: material, uso, sector al que aplica.' },
];
---

<Layout title="Productos">

  <section class="relative overflow-hidden bg-hero-gradient text-white py-28 px-5 text-center">
    <div data-anim="hero-bg" class="absolute inset-0 bg-hero-gradient opacity-90 -z-10"></div>
    <h1 data-anim="hero-title" class="text-4xl font-bold mb-4">Nuestros Productos</h1>
    <p data-anim="hero-text" class="text-lg opacity-95 max-w-xl mx-auto">
      Catálogo de piezas y soluciones plásticas fabricadas por inyección.
    </p>
  </section>

  <section class="py-24 px-5">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-primario text-center mb-3" data-anim="reveal">Catálogo</h2>
      <p class="text-slate-500 text-center max-w-xl mx-auto mb-12" data-anim="reveal">
        Reemplaza estas imágenes y textos con los productos reales de Marceplast.
      </p>
      <div data-anim="stagger-group" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {productos.map((p) => (
          <ProductCard img={p.img} title={p.title} description={p.description} />
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-5 bg-fondo-alterno text-center" data-anim="section-pin">
    <div class="max-w-2xl mx-auto" data-anim="reveal">
      <h2 class="text-3xl font-bold text-primario mb-4">¿Buscas un producto a medida?</h2>
      <p class="text-slate-500 mb-8">
        Contáctanos y diseñamos una solución de inyección de plástico para tu necesidad.
      </p>
      <a href="/contacto" class="inline-block bg-primario hover:bg-primario-oscuro transition-colors text-white px-8 py-4 rounded-lg font-semibold">
        Contáctanos
      </a>
    </div>
  </section>

  <script>
    import { initAnimations } from '../scripts/animations.js';
    initAnimations();
  </script>
</Layout>
