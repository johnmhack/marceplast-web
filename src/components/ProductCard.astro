---
export interface Props {
  img: string;
  title: string;
  description: string;
  href?: string;
}
const { img, title, description, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class="group block bg-white rounded-2xl overflow-hidden ring-1 ring-slate-200/80 shadow-sm hover:shadow-lg hover:ring-primario/30 transition-all duration-300"
>
  <div class="overflow-hidden aspect-[16/11]">
    <img
      src={img}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>
  <div class="p-6 sm:p-7">
    <h3 class="text-primario-oscuro font-bold text-xl sm:text-2xl mb-2 group-hover:text-primario transition-colors">
      {title}
    </h3>
    <p class="text-slate-600 text-base leading-relaxed mb-4">{description}</p>
    {href && (
      <span class="inline-flex items-center gap-1.5 text-primario font-semibold text-sm">
        Conocer más
        <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
      </span>
    )}
  </div>
</Tag>
